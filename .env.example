# Frontend: leave blank for local development (Vite proxies /api to localhost:3001).
# For Netlify, set VITE_API_BASE to your deployed backend origin, e.g. https://webphase-api.onrender.com
VITE_API_BASE=

# Backend (production): set a long random secret and a frontend origin allowed to use cookies.
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=production
# Set to 1 only when deployed behind a trusted reverse proxy (for example Render).
TRUST_PROXY=0
CORS_ORIGIN=http://localhost:5173
# Optional persistent mount points. Local defaults are ./data and ./uploads.
DATA_DIR=
UPLOAD_DIR=
